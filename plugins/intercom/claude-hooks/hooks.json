{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/claude/hook.mjs\"",
            "asyncRewake": true,
            "timeout": 7205
          }
        ]
      }
    ],
    "UserPromptSubmit": [
